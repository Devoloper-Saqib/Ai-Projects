<!DOCTYPE html>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Your Generated Website</title>
<style>
body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 0; padding: 24px; }
.row { display: grid; grid-template-columns: 1fr; gap: 24px; }
@media (min-width: 1100px) { .row { grid-template-columns: 1fr 1fr; } }
textarea { width: 100%; height: 70vh; padding: 12px; }
iframe { width: 100%; height: 80vh; border: 1px solid #ddd; border-radius: 12px; }
.actions { display: flex; gap: 12px; margin-bottom: 12px; }
button { padding: 10px 16px; border-radius: 8px; border: none; cursor: pointer; }
</style>
</head>
<body>
<div class="row">
<section>
<div class="actions">
<button id="copyBtn">Copy HTML</button>
<button id="downloadBtn">Download .html</button>
</div>
<textarea id="code" readonly><%- generatedHTML %></textarea>
</section>
<section>
<iframe id="preview" srcdoc="<%- generatedHTML %>"></iframe>
</section>
</div>


<script>
const codeEl = document.getElementById('code');


document.getElementById('copyBtn').addEventListener('click', async () => {
try {
await navigator.clipboard.writeText(codeEl.value);
alert('Copied to clipboard!');
} catch (e) {
alert('Copy failed. Select and copy manually.');
}
});


document.getElementById('downloadBtn').addEventListener('click', () => {
const blob = new Blob([codeEl.value], { type: 'text/html' });
const url = URL.createObjectURL(blob);
const a = document.createElement('a');
a.href = url;
a.download = 'ai-generated-site.html';
document.body.appendChild(a);
a.click();
a.remove();
URL.revokeObjectURL(url);
});
</script>
</body>
</html>