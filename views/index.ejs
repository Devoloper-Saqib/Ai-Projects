<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Website Generator</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/Css/style.css">
</head>

<body>
  <div class="container">
    <h1>Let AI Build Your Custom Website</h1>
    <form action="/generate" method="POST" class="glass-container">
      <textarea name="prompt" id="input"
        placeholder="e.g. A tech startup landing page with a hero, features grid, and contact form in dark theme"></textarea>
      <button type="submit" id="generateForm">Generate</button>
    </form>
  </div>
  <script src="/Js/index.js"></script>
</body>

</html>